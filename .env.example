# Database (Postgres). For local dev with the bundled instance:
DATABASE_URL="postgresql://celebrate:celebrate@localhost:5432/celebrate?schema=public"

# Session signing secret (any random 32+ byte string)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Provider selection. Use `mock` in development so the app runs without external keys.
OTP_PROVIDER="mock"          # mock | hubtel
WHATSAPP_PROVIDER="mock"     # mock | meta
PAYMENT_PROVIDER="mock"      # mock | paystack
AI_PROVIDER="mock"           # mock | anthropic
IMAGE_PROVIDER="mock"        # mock | gemini   (Imagen 4)
VIDEO_PROVIDER="mock"        # mock | gemini   (Veo 3, future)

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_BUDGET="claude-opus-4-7"
ANTHROPIC_MODEL_FAST="claude-sonnet-4-6"

# Google Gemini (used when IMAGE_PROVIDER=gemini or VIDEO_PROVIDER=gemini)
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="imagen-4.0-generate-001"
GEMINI_VIDEO_MODEL="veo-3.0-generate-001"

# Hubtel SMS / OTP (used when OTP_PROVIDER=hubtel)
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
HUBTEL_SENDER_ID="Celebrate"

# WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta)
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_TOKEN=""
META_WHATSAPP_VERIFY_TOKEN=""

# Paystack (used when PAYMENT_PROVIDER=paystack); ALWAYS sandbox keys in dev
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Public origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# TEMPORARY (stakeholder review phase): demo mode is ON by default — phone-OTP
# auth is bypassed and every visitor is signed in as a single demo user. To
# restore real auth, set DEMO_MODE="0" (or "false") explicitly.
# DEMO_MODE="0"
