// Celebrate — Prisma schema (Phase 0 + Phase 1 slice)
// All money fields are integer minor units (GHS pesewas). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  @unique
  displayName  String?
  locale       String   @default("en-GH")
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  ownedEvents  Event[]   @relation("EventOwner")
  memberships  EventMember[]
  aiInvocations AiInvocation[]
  conciergeConversations ConciergeConversation[]
  preferences  UserPreferences?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpRequest {
  id          String   @id @default(cuid())
  phone       String
  codeHash    String
  purpose     String   // 'login' | 'rsvp'
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  ipHash      String?
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
}

// ─────────────────────────── Events ─────────────────────────────

enum EventType {
  wedding
}

enum EventVisibility {
  public
  unlisted
  private
}

enum EventStatus {
  draft
  published
  archived
}

enum Region {
  greater_accra
  ashanti
  western
  central
  eastern
  volta
  northern
  upper_east
  upper_west
  bono
  bono_east
  ahafo
  oti
  savannah
  north_east
  western_north
}

model Event {
  id            String          @id @default(cuid())
  slug          String          @unique
  type          EventType       @default(wedding)
  title         String
  story         String?         @db.Text
  ownerId       String
  owner         User            @relation("EventOwner", fields: [ownerId], references: [id])
  eventDate     DateTime
  eventTime     String?         // "HH:mm" Africa/Accra
  region        Region
  city          String
  venueName     String?
  venueAddress  String?
  coverImageUrl String?
  visibility    EventVisibility @default(unlisted)
  status        EventStatus     @default(draft)
  brideName     String?
  groomName     String?
  guestCount    Int             @default(100)
  settings      Json            @default("{}")
  templateId    String          @default("adinkra")
  pageDesign    Json            @default("{}")
  designVersion Int             @default(0)
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  members EventMember[]
  guests  Guest[]
  rsvps   Rsvp[]
  budget  Budget?
  aiInvocations AiInvocation[]
  mediaAssets   MediaAsset[]
  designBriefs  DesignBrief[]
  giftIntents   GiftIntent[]
  gifts         Gift[]
  payoutAccount EventPayoutAccount?
  outboundMessages OutboundMessage[]
  inboundMessages  InboundMessage[]
  conciergeConversations ConciergeConversation[]

  @@index([ownerId])
  @@index([status, eventDate])
}

enum EventRole {
  owner
  editor
  viewer
}

model EventMember {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      EventRole
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ─────────────────────── Guests & RSVP ──────────────────────────

enum InviteChannel {
  whatsapp
  sms
  email
  link
}

model Guest {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  phone           String
  displayName     String
  email           String?
  groupTag        String?
  tableNumber     Int?
  plusOnesAllowed Int           @default(0)
  invitedVia      InviteChannel @default(whatsapp)
  notes           String?
  shortCode       String        @unique // for /r/<shortCode>
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rsvp           Rsvp?
  outboundMessages OutboundMessage[]
  inboundMessages  InboundMessage[]

  @@unique([eventId, phone])
  @@index([eventId])
}

enum RsvpStatus {
  pending
  yes
  no
  maybe
}

model Rsvp {
  id          String     @id @default(cuid())
  guestId     String     @unique
  guest       Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      RsvpStatus @default(pending)
  plusOnes    Int        @default(0)
  dietary     String?
  message     String?
  channel     String?    // 'whatsapp' | 'sms' | 'web'
  respondedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([eventId, status])
}

// ─────────────────────────── Budget ─────────────────────────────

model Budget {
  id            String   @id @default(cuid())
  eventId       String   @unique
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  totalMinor    Int      @default(0)
  generatedByAi Boolean  @default(false)
  sourceInputs  Json     @default("{}")
  assumptions   Json     @default("[]")
  warnings      Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items BudgetLineItem[]
}

model BudgetLineItem {
  id            String  @id @default(cuid())
  budgetId      String
  budget        Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category      String
  label         String
  plannedMinor  Int     @default(0)
  actualMinor   Int     @default(0)
  lowMinor      Int     @default(0)
  highMinor     Int     @default(0)
  notes         String?
  orderIndex    Int     @default(0)

  @@index([budgetId])
}

// ───────────────────────── AI logging ───────────────────────────

model AiInvocation {
  id           String   @id @default(cuid())
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature      String   // 'budget_estimator' | 'planning_assistant' | 'vendor_match' | 'rsvp_drafter'
  modelId      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  status       String   // 'ok' | 'error' | 'fallback'
  error        String?
  createdAt    DateTime @default(now())

  @@index([feature, createdAt])
}

// ─────────────────────────── Audit ──────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  eventId     String?
  action      String
  target      String?
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([eventId, createdAt])
}

// ─────────────────────── Concierge (AI agent) ──────────────────

enum ConciergeRole {
  user
  assistant
  tool_result
}

model ConciergeConversation {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary       String   @default("") @db.Text
  summaryUpToMessageId String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ConciergeMessage[]

  @@unique([eventId, userId])
  @@index([userId, lastMessageAt(sort: Desc)])
}

model ConciergeMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   ConciergeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ConciergeRole
  content        String                @db.Text
  toolName       String?
  toolInput      Json?
  toolResult     Json?
  toolUseId      String?               // matches Claude tool_use block ids across rounds
  modelId        String?
  inputTokens    Int                   @default(0)
  outputTokens   Int                   @default(0)
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

enum ToneBand {
  warm
  formal
  brief
  playful
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toneBand             ToneBand @default(warm)
  detectedFromHistory  Boolean  @default(false)
  toneSignalCount      Int      @default(0)   // running count of same-tone signals for hysteresis
  pendingToneBand      ToneBand?               // tone we're considering switching to
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

enum MessageChannel {
  whatsapp
  sms
}

enum MessageDirection {
  outbound
  inbound
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

model OutboundMessage {
  id              String           @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)
  toPhone         String
  channel         MessageChannel
  templateKey     String           // e.g. 'save_the_date' | 'rsvp_reminder' | 'thank_you_followup'
  body            String           @db.Text
  status          MessageStatus    @default(queued)
  provider        String           // 'mock' | 'meta' | 'hubtel'
  providerMessageId String?
  failureReason   String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([eventId, createdAt(sort: Desc)])
  @@index([providerMessageId])
}

enum RsvpIntent {
  rsvp_yes
  rsvp_no
  rsvp_maybe
  dietary
  plus_one
  question
  other
}

model InboundMessage {
  id              String           @id @default(cuid())
  eventId         String?
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  guestId         String?
  guest           Guest?           @relation(fields: [guestId], references: [id], onDelete: SetNull)
  fromPhone       String
  channel         MessageChannel
  body            String           @db.Text
  receivedAt      DateTime         @default(now())
  providerMessageId String?        @unique
  intent          RsvpIntent?
  intentConfidence Float?
  handledByUserId String?
  handledAt       DateTime?

  draft           AiDraft?

  @@index([eventId, receivedAt(sort: Desc)])
}

enum DraftStatus {
  pending
  approved
  edited_and_sent
  rejected
}

model AiDraft {
  id                String           @id @default(cuid())
  inboundMessageId  String           @unique
  inboundMessage    InboundMessage   @relation(fields: [inboundMessageId], references: [id], onDelete: Cascade)
  draftBody         String           @db.Text
  modelId           String
  status            DraftStatus      @default(pending)
  approverUserId    String?
  approvedAt        DateTime?
  sentOutboundMessageId String?
  rejectedReason    String?
  createdAt         DateTime         @default(now())
}

// ─────────────────────── Money — gifts ─────────────────────────

enum GiftChannel {
  momo_mtn
  momo_telecel
  momo_at
  card
}

enum GiftIntentStatus {
  initiated
  authorized
  succeeded
  failed
  reversed
}

model GiftIntent {
  id              String           @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestPhone      String?          // E.164
  guestName       String
  amountMinor     Int              // pesewas (GHS minor units)
  feeMinor        Int
  totalMinor      Int              // amount + fee, what the gateway actually charges
  currency        String           @default("GHS")
  channel         GiftChannel
  status          GiftIntentStatus @default(initiated)
  gateway         String           // 'paystack' | 'mock'
  gatewayRef      String           @unique // reference sent to gateway
  idempotencyKey  String           @unique
  authorizationUrl String?
  message         String?          @db.Text
  isPublic        Boolean          @default(true)
  failureReason   String?
  initiatedAt     DateTime         @default(now())
  settledAt       DateTime?
  reversedAt      DateTime?
  rawGatewayPayload Json           @default("{}")

  gift Gift?

  @@index([eventId, status])
  @@index([eventId, initiatedAt(sort: Desc)])
}

model Gift {
  id              String   @id @default(cuid())
  giftIntentId    String   @unique
  giftIntent      GiftIntent @relation(fields: [giftIntentId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amountMinor     Int
  feeMinor        Int
  guestName       String
  guestPhone      String?
  channel         GiftChannel
  message         String?  @db.Text
  isPublic        Boolean  @default(true)
  thankedAt       DateTime?
  thankYouMethod  String?  // 'whatsapp' | 'sms' | 'manual'
  thankYouDraft   String?  @db.Text  // AI-drafted thank-you, pending send
  settledAt       DateTime @default(now())

  @@index([eventId, settledAt(sort: Desc)])
}

model EventPayoutAccount {
  id              String   @id @default(cuid())
  eventId         String   @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gateway         String
  gatewaySubaccountId String?
  mode            String   @default("instant") // 'instant' | 'hold'
  payoutPhone     String?  // E.164 MoMo
  payoutProvider  String?  // 'mtn' | 'telecel' | 'at'
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payout {
  id              String   @id @default(cuid())
  eventId         String
  amountMinor     Int
  status          String   // 'requested' | 'paid' | 'failed'
  gatewayPayoutRef String?
  requestedAt     DateTime @default(now())
  completedAt     DateTime?
  failureReason   String?

  @@index([eventId, requestedAt(sort: Desc)])
}

// ─────────────────────── Design studio ──────────────────────────

model MediaAsset {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind        String   // 'image' | 'video'
  url         String   @db.Text // data URL or external URL
  prompt      String?  @db.Text
  provider    String   // 'mock' | 'gemini' | 'replicate' | 'upload'
  modelId     String?
  mimeType    String?
  width       Int?
  height      Int?
  bytes       Int?
  createdAt   DateTime @default(now())

  @@index([eventId, createdAt])
}

model DesignBrief {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  brief       String   @db.Text
  vibe        String   // 'warm' | 'elegant' | 'bold' | 'minimal'
  templateId  String
  generated   Json     // the structured PageDesign produced by Claude
  modelId     String
  createdAt   DateTime @default(now())

  @@index([eventId, createdAt])
}
